# Finder noise — the project-scoped .gitignore no longer covers this level
.DS_Store
**/.DS_Store

# Never wanted anywhere in the tree, at any depth. Left unanchored deliberately,
# as defense in depth: a future project whose own .gitignore forgets these is
# still covered.
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Insurance against cwd mistakes: bench scripts are cwd-sensitive, and a
# hand-run make_qr.py / record_piezos.py from THIS directory would scatter
# project artifacts here, outside the reach of the project's own .gitignore.
#
# Anchored with a leading slash so they match only at the bench root. Unanchored
# they would match at every depth, and a future project that legitimately tracks
# a data/ or build/ directory would find it silently ignored with no error.
/build/
/data/
/table_qr.pdf
